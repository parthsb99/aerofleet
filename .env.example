# ==============================================================================
# AeroFleet – Environment Variables Reference
# ==============================================================================
# Copy this file to .env for local development.
# For Render, set these in the Render Dashboard → Environment Variables.
# NEVER commit real secrets to git.
# ==============================================================================

# ── Backend Environment Variables ─────────────────────────────────────────────
# (Set in Render Dashboard for the aerofleet-backend service)

NODE_ENV=production
# PORT is injected automatically by Render — do not set it

# MongoDB Atlas connection string (free cluster: https://cloud.mongodb.com)
MONGO_URI=mongodb+srv://your_user:your_password@cluster0.xxxxx.mongodb.net/vsa_db?retryWrites=true&w=majority

# JWT signing secret — use a long random string
JWT_SECRET=replace_with_a_long_random_secret_string_at_least_64_chars

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=https://aerofleet-frontend.onrender.com

# ── Frontend Environment Variables ────────────────────────────────────────────
# (Set in Render Dashboard for the aerofleet-frontend static site)
# Must be prefixed with VITE_ to be exposed to the browser build

VITE_API_URL=https://aerofleet-backend.onrender.com
VITE_SOCKET_URL=https://aerofleet-backend.onrender.com
